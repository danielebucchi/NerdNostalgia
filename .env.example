# NerdNostalgia — variabili d'ambiente
# Copia in .env e personalizza. .env non e' versionato.

# ---------- Generic ----------
TZ=Europe/Rome
APP_TIMEZONE=Europe/Rome

# ---------- Backend ----------
# Disabilita lo scheduler APScheduler (utile in dev se non vuoi log Vinted)
# DISABLE_SCHEDULER=1

# JWT signing key — CAMBIALA in produzione (almeno 64 char random)
JWT_SECRET_KEY=dev-secret-change-me

# ---------- SMTP (Gmail App Password compatibile) ----------
EMAIL_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO_ADMIN=nerdnostalgiaita@gmail.com

# ---------- Suggerimenti indirizzo al checkout (Geoapify) ----------
# Chiave del piano gratuito su https://myprojects.geoapify.com (niente carta).
# Resta server-side: il browser chiama /api/address/autocomplete, non Geoapify.
# Vuota = nessun suggerimento, il compratore scrive l'indirizzo a mano.
GEOAPIFY_API_KEY=
# Paesi in cui cercare, codici ISO separati da virgola.
ADDRESS_COUNTRY_CODES=it

# ---------- PayPal (bottoni ufficiali, Orders v2) ----------
# Credenziali da https://developer.paypal.com → My Apps & Credentials.
# Si parte in sandbox: PAYPAL_ENV=live solo quando hai provato tutto.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook (stessa pagina, sezione Webhooks): senza, le notifiche
# vengono rifiutate perche' non possiamo verificarne la firma.
PAYPAL_WEBHOOK_ID=

# ---------- Locker InPost (Geowidget) ----------
# Token generato dal pannello InPost, sezione Geowidget. E' pubblico (finisce
# nel browser) ma vincolato al dominio: ne serve uno per localhost e uno per
# nerdnostalgia.store. Vuoto = niente mappa, il checkout lo dice e rimanda ai
# contatti.
INPOST_GEOWIDGET_TOKEN=
# Host del widget: da cambiare se per l'Italia InPost ne usa uno diverso.
# Vuoto = https://geowidget.inpost.pl
INPOST_WIDGET_BASE=
# Lingue supportate dal widget: pl / en / uk. L'italiano non c'e': con
# "it" i messaggi escono in POLACCO. Lasciare "en".
INPOST_WIDGET_LANGUAGE=en

# ---------- Frontend (build-time, baked into Next.js bundle) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:7373
NEXT_PUBLIC_SITE_URL=http://localhost:3737
# Handle paypal.me per il bottone Donazione + (se abilitati) PayPal checkout.
# Se vuoto, i bottoni PayPal sono nascosti.
NEXT_PUBLIC_PAYPAL_ME=
# Master switch per la pipeline d'acquisto (carrello, CTA "Paga con PayPal"
# sull'articolo, /carrello, /admin/ordini). False = nasconde tutto.
# La Donazione (FAB in basso a destra) resta sempre visibile se PAYPAL_ME
# e' configurato, indipendentemente da questo flag.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ---------- Backup (opzionali) ----------
# Se BACKUP_S3_BUCKET e' settato, il job giornaliero carica anche su S3/R2
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=  # solo per R2/MinIO; vuoto per AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
